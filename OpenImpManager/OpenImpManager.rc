#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_MAIN DIALOGEX 0, 0, 320, 270
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "OpenImp Badge Sign-in"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Sign-in tile", -1, 7, 5, 306, 38
    LTEXT           "", IDC_INSTALL_STATUS, 15, 20, 170, 16
    PUSHBUTTON      "Install", IDC_INSTALL, 190, 18, 55, 15
    PUSHBUTTON      "Uninstall", IDC_UNINSTALL, 250, 18, 55, 15

    GROUPBOX        "Enrolled badges", -1, 7, 48, 306, 100
    CONTROL         "", IDC_BADGES, WC_LISTVIEW, LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 15, 60, 290, 64
    PUSHBUTTON      "Remove selected", IDC_REMOVE, 235, 128, 70, 15

    GROUPBOX        "Add a badge", -1, 7, 153, 306, 110
    LTEXT           "", IDC_READER_STATUS, 15, 166, 290, 10
    LTEXT           "Badge ID:", -1, 15, 182, 50, 10
    EDITTEXT        IDC_BADGE_ID, 70, 180, 235, 13, ES_READONLY | ES_AUTOHSCROLL
    LTEXT           "Windows user:", -1, 15, 200, 50, 10
    COMBOBOX        IDC_ACCOUNT, 70, 198, 175, 100, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Refresh", IDC_REFRESH_USERS, 250, 197, 55, 15
    LTEXT           "Password:", -1, 15, 218, 50, 10
    EDITTEXT        IDC_PASSWORD, 70, 216, 235, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Save badge", IDC_SAVE, 235, 240, 70, 15
END
